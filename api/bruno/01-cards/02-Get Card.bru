meta {
  name: 02-Get Card
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/cards/{{cardNumber}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.card_number: eq {{cardNumber}}
  res.body.status: eq ACTIVE
}

tests {
  test("returns valid card matching requested card number", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.card_number).to.equal(bru.getVar("cardNumber") || bru.getEnvVar("cardNumber"));
    expect(body.status).to.equal("active");
  });
}
