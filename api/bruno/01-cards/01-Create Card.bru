meta {
  name: 01-Create Card
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/cards
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "initial_balance": 50000
  }
}

assert {
  res.status: eq 201
  res.body.balance: eq 50000
  res.body.status: eq ACTIVE
}

script:post-response {
  if (res.getStatus() === 201) {
    const data = res.getBody();
    bru.setVar("cardNumber", data.card_number);
    bru.setEnvVar("cardNumber", data.card_number);
  }
}

tests {
  test("card provisioned successfully", function() {
    expect(res.getStatus()).to.equal(201);
    const body = res.getBody();
    expect(body.card_number).to.match(/^[0-9]{16}$/);
    expect(body.balance).to.equal(50000);
    expect(body.status).to.equal("active");
  });
}
