meta {
  name: 04-Tap In Insufficient Balance
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/gate/tap-in
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "card_number": "{{emptyCardNumber}}",
    "station_id": "MRT-BHI"
  }
}

assert {
  res.status: eq 402
  res.body.error: isDefined
}

tests {
  test("gate entry denied when card balance is below minimum Rp 5,000", function() {
    expect(res.getStatus()).to.equal(402);
    expect(res.getBody().error).to.include("insufficient balance");
  });
}
