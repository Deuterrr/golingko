meta {
  name: 02-Filter MRT
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/stations?mode=mrt
  body: none
  auth: none
}

params:query {
  mode: MRT
}

assert {
  res.status: eq 200
}

tests {
  test("all stations returned are MRT mode", function() {
    expect(res.getStatus()).to.equal(200);
    const body = res.getBody();
    expect(body.length).to.be.above(0);
    body.forEach(function(station) {
      expect(station.mode).to.equal("mrt");
    });
  });
}
