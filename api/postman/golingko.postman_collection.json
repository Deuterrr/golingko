    {
      "name": "03 Gate Commute Lifecycle",
      "item": [
        {
          "name": "01 Gate Tap-In (MRT Bundaran HI)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Gate opened and journey status is IN_PROGRESS\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.gate_opened).to.be.true;",
                  "    pm.expect(json.journey.status).to.eql(\"IN_PROGRESS\");",
                  "    pm.expect(json.journey.entry_station_id).to.eql(\"MRT-BHI\");",
                  "    pm.expect(json.journey.id).to.be.a(\"string\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
