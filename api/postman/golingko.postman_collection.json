          "name": "03 Gate Tap-Out & Tariff Clearance (MRT Lebak Bulus)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Exit gate opened, trip completed, and fare settled\", function () {",
                  "    var json = pm.response.json();",
