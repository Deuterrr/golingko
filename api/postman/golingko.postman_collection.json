                  "    pm.expect(json.journey.exit_station_id).to.eql(\"MRT-BLB\");",
                  "    pm.expect(json.fare.fare_amount).to.be.above(0);",
                  "    pm.expect(json.remaining_balance).to.eql(75000 - json.fare.fare_amount);",
                  "});"
