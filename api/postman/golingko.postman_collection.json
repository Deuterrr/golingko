    {
      "name": "01 Cards & Ledger",
      "item": [
        {
          "name": "01 Create Transit Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Card generated with 16 digits and initial balance\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.id).to.be.a(\"string\");",
                  "    pm.expect(json.card_number).to.match(/^[0-9]{16}$/);",
                  "    pm.expect(json.balance).to.eql(50000);",
                  "    pm.expect(json.status).to.eql(\"ACTIVE\");",
                  "    pm.collectionVariables.set(\"cardNumber\", json.card_number);",
                  "    pm.environment.set(\"cardNumber\", json.card_number);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"initial_balance\": 50000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cards",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cards"
              ]
            },
            "description": "Provisions a virtual transit card with auto-generated 16-digit card number."
          },
          "response": []
        },
        {
          "name": "02 Get Card Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Card details match created card\", function () {",
                  "    var json = pm.response.json();",
                  "    var currentCard = pm.collectionVariables.get(\"cardNumber\") || pm.environment.get(\"cardNumber\");",
                  "    pm.expect(json.card_number).to.eql(currentCard);",
                  "    pm.expect(json.status).to.eql(\"ACTIVE\");",
                  "    pm.expect(json.balance).to.be.a(\"number\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cards/{{cardNumber}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cards",
                "{{cardNumber}}"
              ]
            },
            "description": "Fetch card metadata and current stored value balance."
          },
          "response": []
        },
        {
          "name": "03 Top Up Card (Atomic & Idempotent)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "var uuid = pm.variables.replaceIn('{{$guid}}');",
                  "var key = 'topup-key-' + uuid;",
                  "pm.collectionVariables.set('topUpIdempotencyKey', key);",
                  "pm.request.headers.upsert({key: 'Idempotency-Key', value: key});"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Card balance increased by Rp 25,000 and TOP_UP recorded in ledger\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.card.balance).to.eql(75000);",
                  "    pm.expect(json.transaction.transaction_type).to.eql(\"TOP_UP\");",
                  "    pm.expect(json.transaction.amount).to.eql(25000);",
                  "    pm.expect(json.transaction.balance_after).to.eql(75000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{topUpIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cards/{{cardNumber}}/top-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cards",
                "{{cardNumber}}",
                "top-up"
              ]
            },
            "description": "Credits card balance atomically and logs ledger transaction."
          },
          "response": []
        },
        {
          "name": "04 Top Up Card Idempotency Cache Hit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"X-Cache-Lookup header is HIT\", function () {",
                  "    pm.expect(pm.response.headers.get(\"X-Cache-Lookup\")).to.eql(\"HIT\");",
                  "});",
                  "pm.test(\"Balance unchanged and identical response body returned\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json.card.balance).to.eql(75000);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{topUpIdempotencyKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": 25000\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/cards/{{cardNumber}}/top-up",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cards",
                "{{cardNumber}}",
                "top-up"
              ]
            },
            "description": "Re-sends identical Idempotency-Key to verify in-memory deduplication cache."
          },
          "response": []
        },
        {
          "name": "05 Get Card Transactions",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Transaction list contains ledger entries\", function () {",
                  "    var json = pm.response.json();",
                  "    pm.expect(json).to.be.an(\"array\");",
                  "    pm.expect(json.length).to.be.at.least(1);",
                  "    pm.expect(json[0]).to.have.property(\"transaction_type\");",
                  "    pm.expect(json[0]).to.have.property(\"balance_after\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/cards/{{cardNumber}}/transactions?limit=10",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "cards",
                "{{cardNumber}}",
                "transactions"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "Audit trail of double-entry ledger records for the card."
          },
          "response": []
        }
      ]
    },
