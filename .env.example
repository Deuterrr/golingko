# Server & Routing
SERVER_ADDR=127.0.0.1:8080 # listen address (127.0.0.1:8080 for loopback, 0.0.0.0:8080 for Docker; accepts PORT alias)
HTTP_ROUTER=nethttp         # implementation: nethttp | chi | gin

# Database Settings (PostgreSQL / Supabase / Cloud)
# Optional: Unified connection URI (e.g. Supabase, Neon, AWS RDS). Takes precedence over DB_* if set.
# DATABASE_URL=postgresql://postgres.yourprojectref:password@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?sslmode=require

DB_HOST=localhost
DB_PORT=5432
DB_USER=golingko_user
DB_PASSWORD=golingko_password
DB_NAME=golingko_db
DB_SSLMODE=disable

# Redis Cache & Messaging
REDIS_URL=localhost:6379

# Transit Domain Policies (IDR)
MIN_TAP_BALANCE=5000        # Minimum card balance required to tap in at turnstiles.
JAKLINGKO_FARE_CAP=10000    # Maximum fare cap for integrated JakLingko journeys.
JOURNEY_EXPIRY_HOURS=4      # Maximum trip duration in hours before an unclosed journey is marked abandoned.

# Logging Subsystem
LOG_DRIVER=slog        # driver: slog | zap | zerolog | noop
LOG_VERBOSITY=info     # verbosity threshold: debug | info | warn | error
LOG_FORMAT=json        # format: json | text
